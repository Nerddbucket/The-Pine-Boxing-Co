---
import { site } from '../../config/site';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import ZenPlannerWidget from '../ui/ZenPlannerWidget.astro';

const { calendar, membership } = site.zenplanner;
---

<section id="join" class="bg-pines-black py-20 lg:py-28">
  <Container>
    <SectionTitle title={site.join.title} />
    <p class="mb-12 max-w-2xl text-pines-muted">{site.join.description}</p>

    <div class="border border-white/10 bg-pines-charcoal">
      <div class="border-b border-white/10 p-4 sm:p-6 lg:p-8">
        <h3 class="font-display text-lg tracking-wider text-pines-red">{site.join.scheduleLabel}</h3>
        <p class="mt-2 mb-6 max-w-2xl text-sm text-pines-muted">{site.join.scheduleDescription}</p>
        <ZenPlannerWidget
          module={calendar.module}
          partitionApiKey={site.zenplanner.partitionApiKey}
          widgetInstanceId={calendar.widgetInstanceId}
          host={site.zenplanner.host}
          scriptPath={site.zenplanner.scriptPath}
        />
      </div>

      <div class="p-4 sm:p-6 lg:p-8">
        <h3 class="font-display text-lg tracking-wider text-pines-red">{site.join.membershipLabel}</h3>
        <p class="mt-2 mb-6 max-w-2xl text-sm text-pines-muted">{site.join.membershipDescription}</p>
        <ZenPlannerWidget
          module={membership.module}
          partitionApiKey={site.zenplanner.partitionApiKey}
          widgetInstanceId={membership.widgetInstanceId}
          host={site.zenplanner.host}
          scriptPath={site.zenplanner.scriptPath}
        />
      </div>
    </div>
  </Container>
</section>
