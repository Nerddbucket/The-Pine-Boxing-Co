---
import { site } from '../../config/site';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import ZenPlannerWidget from '../ui/ZenPlannerWidget.astro';

const { calendar } = site.zenplanner;
---

<section id="schedule" class="bg-pines-black py-20 lg:py-28">
  <Container>
    <SectionTitle title={site.schedule.title} />
    <p class="mb-12 max-w-2xl text-pines-muted">{site.schedule.description}</p>

    <div class="border border-white/10 bg-pines-charcoal p-4 sm:p-6 lg:p-8">
      <ZenPlannerWidget
        module={calendar.module}
        partitionApiKey={site.zenplanner.partitionApiKey}
        widgetInstanceId={calendar.widgetInstanceId}
        host={site.zenplanner.host}
        scriptPath={site.zenplanner.scriptPath}
      />
    </div>
  </Container>
</section>
