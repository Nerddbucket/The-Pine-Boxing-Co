---
import { site } from '../../config/site';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import AcuityScheduleButton from '../ui/AcuityScheduleButton.astro';

const { comingSoon } = site.membership;
---

<section id="membership" class="bg-pines-black py-20 lg:py-28">
  <Container>
    <SectionTitle title={site.membership.title} />
    <p class="mb-12 max-w-2xl text-pines-muted">{site.membership.description}</p>

    <div
      class="border border-pines-red/40 bg-pines-charcoal p-8 text-center lg:p-16"
      aria-labelledby="membership-coming-soon-heading"
    >
      <span class="font-display text-xs tracking-widest text-pines-red">{comingSoon.label}</span>
      <h3
        id="membership-coming-soon-heading"
        class="mt-4 font-display text-2xl tracking-wider text-pines-white md:text-3xl"
      >
        {comingSoon.headline}
      </h3>
      <p class="mx-auto mt-6 max-w-2xl text-pines-muted">{comingSoon.body}</p>

      <ul class="mt-10 flex flex-wrap justify-center gap-4">
        {
          comingSoon.plannedTiers.map((tier) => (
            <li class="border border-white/10 px-5 py-3 font-display text-sm tracking-wider text-pines-muted">
              {tier}
            </li>
          ))
        }
      </ul>

      <AcuityScheduleButton label="SCHEDULE A VISIT" variant="solid-red" class="mt-10" />
    </div>
  </Container>
</section>
